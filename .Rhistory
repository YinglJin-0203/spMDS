library(splines)
library(Matrix)
library(igraph)
library(tidyverse)
library(magick)
source("R/Helpers.R")
source("R/spMDS.R")
set.seed(123)
#' Split the objective into its stress and penalty components
#'
#' @param delta_list list of T dissimilarity matrices
#' @param Ct_list list of T precomputed Phi_t matrices (P x PK)
#' @param B fitted coefficient matrix (PK x D)
#' @return list with stress and penalty (unweighted, i.e. penalty = ||B||_1,
#'         not lambda*||B||_1 -- this is what the L-curve needs)
compute_stress_and_penalty <- function(delta_list, C_list, B) {
T_len <- length(delta_list)
stress_total <- 0
for (t in 1:T_len) {
Ct <- C_list[[t]]
d_t <- pairwise_dist(Ct)
delta_t <- delta_list[[t]]
idx_upper <- upper.tri(delta_t, diag = TRUE)
stress_total <- stress_total + sum((delta_t[idx_upper] - d_t[idx_upper])^2)
}
penalty <- sum(abs(B))
movement <-  sum(sapply(2:nT, function(t) sum((C_list[[t]] - C_list[[t-1]])^2)))
list(stress = stress_total, penalty = penalty, movement = movement)
}
#' @param rho ADMM penalty parameter (held fixed across lambda)
#' @param admm_iter, max_iter, tol passed through to spMDS at each lambda
#' @param warm_start if TRUE, use previous lambda's fitted B as the next
#'   B_init, which substantially speeds up the sweep
#' @param verbose_fit passed to spMDS's own verbose flag (per-iteration
#'   printing) -- usually FALSE here since you already get progress
#'   printed per lambda
#' @return a data.frame with columns lambda, stress, penalty, log_stress,
#'   log_penalty, plus a list column-like attribute "fits" holding each
#'   full spMDS result object (attr(result, "fits"))
compute_lcurve <- function(delta_list, phi_list, P, K, D,
lambda_seq, rho = 1,
admm_iter = 15, max_iter = 1000, tol = 1e-5,
warm_start = TRUE, verbose_fit = FALSE) {
lambda_seq <- sort(lambda_seq, decreasing = TRUE)
n_lambda <- length(lambda_seq)
stress_vec <- numeric(n_lambda)
penalty_vec <- numeric(n_lambda)
movement_vec <- numeric(n_lambda)
fits <- vector("list", n_lambda)
# Precompute Phi_list once -- shared across all lambda fits
Phi_list <- lapply(phi_list, function(phi_t) build_Phi_t(phi_t, P))
B_warm <- NULL
for (i in seq_len(n_lambda)) {
lam <- lambda_seq[i]
cat(sprintf("\n--- Fitting lambda = %.5g (%d/%d) ---\n", lam, i, n_lambda))
t_elapsed <- system.time({
fit_i <- spMDS(
delta_list = delta_list,
phi_list = phi_list,
P = P, K = K, D = D,
lambda = lam, rho = rho,
admm_iter = admm_iter, max_iter = max_iter,
tol = tol, B_init = if (warm_start) B_warm else NULL,
verbose = verbose_fit
)
})
sp <- compute_stress_and_penalty(delta_list, Phi_list, fit_i$B)
stress_vec[i] <- sp$stress
penalty_vec[i] <- sp$penalty
movement_vec[i] <- sp$movement
fits[[i]] <- fit_i
if (warm_start) B_warm <- fit_i$B
cat(sprintf("  stress = %.4f, penalty (||B||_1) = %.4f, time = %.1fs\n",
sp$stress, sp$penalty, t_elapsed["elapsed"]))
}
lcurve_df <- data.frame(
lambda = lambda_seq,
stress = stress_vec,
penalty = penalty_vec,
movement = movement_vec
)
attr(lcurve_df, "fits") <- fits
return(lcurve_df)
}
#' Plot the L-curve (log-log) with lambda labels
#'
#' @param lcurve_df output of compute_lcurve()
#' @param label_points if TRUE, annotate each point with its lambda value
plot_lcurve <- function(lcurve_df, label_points = TRUE) {
plot(lcurve_df$log_penalty, lcurve_df$log_stress,
type = "b", pch = 19, col = "steelblue",
xlab = "log( ||B||_1 )  [regularization]",
ylab = "log( stress )  [data fidelity]",
main = "L-curve for spMDS")
if (label_points) {
text(lcurve_df$log_penalty, lcurve_df$log_stress,
labels = signif(lcurve_df$lambda, 3),
pos = 3, cex = 0.7, col = "gray30")
}
}
#' Estimate the L-curve corner via maximum curvature
##
## Uses the standard finite-difference curvature estimate on the
## (log_penalty, log_stress) curve. Requires lambda_seq to have been
## fit at reasonably fine, monotonic resolution for a stable estimate.
## Returns the lambda at the point of maximum curvature.
lcurve_corner <- function(lcurve_df) {
x <- lcurve_df$log_penalty
y <- lcurve_df$log_stress
n <- length(x)
if (n < 3) stop("Need at least 3 lambda values to estimate curvature.")
# Ensure ordered by x (penalty) for finite-difference derivatives
ord <- order(x)
x <- x[ord]; y <- y[ord]
lam_ord <- lcurve_df$lambda[ord]
dx <- diff(x)
dy <- diff(y)
# first derivatives at midpoints, then curvature via standard formula
dx1 <- (x[3:n] - x[1:(n-2)]) / 2
dy1 <- (y[3:n] - y[1:(n-2)]) / 2
dx2 <- x[3:n] - 2*x[2:(n-1)] + x[1:(n-2)]
dy2 <- y[3:n] - 2*y[2:(n-1)] + y[1:(n-2)]
curvature <- abs(dx1 * dy2 - dy1 * dx2) / (dx1^2 + dy1^2)^1.5
best_idx <- which.max(curvature) + 1  # +1 to re-align with original indexing
list(lambda = lam_ord[best_idx], index = best_idx, curvature = curvature)
}
#### Example ####
