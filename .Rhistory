source("R/Helpers.R")
source("R/spMDS.R")
set.seed(123)
# data
df <- read_rds("Manuscripts/Simulation/Data/Data_P9_T100_N100.rds")
head(df)
# dissimilarity
delta_list <- df %>% select(-subject) %>% group_by(time) %>%
group_map(~cor(.x), method = "spearman")
delta_list <- lapply(delta_list, function(x){1-abs(x)})
# splines basis
nT <- length(delta_list)
K <- 30
P <- dim(delta_list[[1]])[1]
knots <- seq(0, nT, length.out = K - 2)[-c(1, K - 2)]
basis_obj <- bs(1:nT, degree = 3, knots = knots, intercept = TRUE)
phi_list <- lapply(1:nT, function(t) as.numeric(basis_obj[t, ]))
View(spMDS)
# fit splines MDS
system.time({
spMDS_fit <- spMDS(
delta_list = delta_list,
phi_list = phi_list,
penalty_type = "l1",
P = P, K = K, D = 2,
lambda = 0.5, rho = 1,
admm_iter = 15, max_iter = 1000,
tol = 1e-5, verbose = TRUE
)
}) # 30 seconds
# Precompute Phi_t for all t (fixed across the whole algorithm)
Phi_list <- lapply(phi_list, function(phi_t) build_Phi_t(phi_t, P))
# Precompute sum_t Phi_t' Phi_t once (does not depend on B or m)
PtP_sum <- Reduce(`+`, lapply(Phi_list, function(Phi_t) t(Phi_t) %*% Phi_t))
Dsum <- if (penalty_type == "temporal") build_Dsum(Phi_list) else NULL
# Initialize B, Z, Y
if (is.null(B_init)) {
B <- matrix(rnorm(PK * D, sd = 0.1), PK, D)
} else {
B <- B_init
}
B <- matrix(rnorm(PK * D, sd = 0.1), PK, D)
T_len <- length(delta_list)
PK <- P * K
B <- matrix(rnorm(PK * D, sd = 0.1), PK, D)
D <- 2
B <- matrix(rnorm(PK * D, sd = 0.1), PK, D)
Z <- B
Y <- matrix(0, PK, D)
obj_history <- numeric(max_iter + 1)
stress <- numeric(max_iter + 1)
movement <- numeric(max_iter + 1)
max_iter = 100
obj_history <- numeric(max_iter + 1)
stress <- numeric(max_iter + 1)
movement <- numeric(max_iter + 1)
objective <- compute_objective(delta_list, Phi_list, B, lambda, penalty_type)
penalty_type = "l1"
penalty_type <- match.arg(penalty_type)
objective <- compute_objective(delta_list, Phi_list, B, lambda, penalty_type)
lambda <- 0.1
objective <- compute_objective(delta_list, Phi_list, B, lambda, penalty_type)
obj_history[1] <- objective['objective']
stress[1] <- objective['stress']
movement[1] <- objective['movement']
compute_objective(delta_list, Phi_list, B, lambda, penalty_type)
